# Copy to .env and fill in. .env is git-ignored; never commit real values.
ENTREZ_EMAIL=your.email@example.com
ENTREZ_API_KEY=your_ncbi_api_key
UMLS_API_KEY=your_umls_api_key
AWS_REGION=us-east-1
# Bedrock access: AWS credentials from the standard AWS credential chain, or a Bedrock API key
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key
